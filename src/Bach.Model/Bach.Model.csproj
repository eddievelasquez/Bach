<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.7.0</Version>
    <Authors>Eddie Velasquez</Authors>
    <Product>Bach Music Library</Product>
    <Copyright>Copyright (c) 2012-2023, Eddie Velasquez</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageProjectUrl />
    <RepositoryUrl>https://github.com/eddievelasquez/bach</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>A .NET library for Western tonal music theory.</Description>
    <RepositoryType>git</RepositoryType>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Bach.Model.Library.json">
      <LogicalName>Bach.Model.Library.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Bach.Model.ExternalAnnotations.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bach.Model.Test" />
  </ItemGroup>
</Project>